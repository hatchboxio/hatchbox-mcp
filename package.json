{
  "name": "@hatchbox/hatchbox-mcp",
  "version": "0.8.2",
  "description": "MCP server that wraps the Hatchbox /api/v1 API",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "hatchbox-mcp": "build/index.js",
    "hatchbox-mcp-http": "build/serve.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js build/serve.js",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "start:http": "node build/serve.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hatchbox",
    "claude",
    "hosting",
    "deployment",
    "devops"
  ],
  "author": "Hatchbox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatchboxio/hatchbox-mcp.git"
  },
  "homepage": "https://github.com/hatchboxio/hatchbox-mcp#readme",
  "bugs": {
    "url": "https://github.com/hatchboxio/hatchbox-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
